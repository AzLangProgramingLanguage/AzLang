data $str2 ={ b "│ AzFetch                │\n", b 0 } 
data $str3 ={ b "├────────────────────────┤\n", b 0 } 
data $str4 ={ b "│ OS       EndeavourOS   │\n", b 0 } 
data $str5 ={ b "│ Kernel   7.1.8         │\n", b 0 } 
data $str6 ={ b "│ CPU      Intel         │\n", b 0 } 
